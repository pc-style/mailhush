#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo "Checking Bun 1.2.9"
if [[ ! -x "$HOME/.local/bin/bun" ]] || [[ "$("$HOME/.local/bin/bun" --version)" != 1.2.9 ]]; then
  BUN_INSTALL="$HOME/.local" BUN_INSTALL_NO_MODIFY_PATH=1 bash -o pipefail -c 'curl -fsSL https://bun.sh/install | bash -s "bun-v1.2.9"'
fi
export PATH="$HOME/.local/bin:$PATH"

echo "Installing extension dependencies"
time bun install --frozen-lockfile

echo "Installing website dependencies"
time npm --prefix website/why ci --no-audit --no-fund

echo "Installing fonts and Xvfb for extension UI captures"
sudo -n apt-get install -y --no-install-recommends fontconfig xvfb fonts-inter fonts-jetbrains-mono fonts-noto-core >/dev/null
if ! fc-list | grep "Cascadia Code" >/dev/null; then
  tmp="$(mktemp -d)"
  curl -fsSL -o "$tmp/c.zip" https://github.com/microsoft/cascadia-code/releases/download/v2407.24/CascadiaCode-2407.24.zip
  unzip -qo "$tmp/c.zip" -d "$tmp/c"
  sudo -n mkdir -p /usr/local/share/fonts/cascadia
  sudo -n cp "$tmp"/c/ttf/*.ttf /usr/local/share/fonts/cascadia/
  rm -rf "$tmp"
fi
fc-cache -f >/dev/null
