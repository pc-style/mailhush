---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="#top" aria-label="MailHush home">
      <Image src={logo} alt="" width={28} height={28} loading="eager" />
      <span>MailHush</span>
      <span class="ver">v2.0</span>
    </a>
    <nav aria-label="Sections">
      <a href="#try">Playground</a>
      <a href="#hides">Detectors</a>
      <a href="#customize">Controls</a>
      <a href="#limits">Limits</a>
    </nav>
    <button class="btn btn-primary nav-cta open-download-modal">Install</button>
  </div>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--paper) 88%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid transparent; transition: border-color 0.3s; }
  :global(body.scrolled) .nav { border-bottom-color: var(--ink); }
  .nav-inner { display: flex; align-items: center; gap: 28px; height: 66px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font: 600 21px/1 var(--display); letter-spacing: -0.02em; }
  .brand img { width: 28px; height: 28px; border-radius: 6px; }
  .ver { font: 500 11px/1 var(--mono); color: var(--stamp); border: 1px solid var(--stamp); padding: 3px 5px; letter-spacing: 0.04em; transform: rotate(-3deg); }
  nav { display: flex; gap: 2px; margin-left: auto; }
  nav a { padding: 8px 12px; text-decoration: none; font: 500 12px/1 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-2); }
  nav a:hover { color: var(--paper); background: var(--ink); }
  .nav-cta { height: 38px; padding: 0 16px; font-size: 12px; box-shadow: 3px 3px 0 var(--stamp); }
  @media (max-width: 820px) { nav { display: none; } .nav-cta { margin-left: auto; } }
</style>
