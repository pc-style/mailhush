---
import { mask } from '../lib/mask';

const email = 'jane.doe@acme-corp.com';
const styles = (['label', 'dots', 'partial'] as const).map((style) => ({ style, out: mask(email, { style }) }));
const custom = mask(`${email} · 4111 1111 1111 1111`, { labels: { email: '<redacted>' } });
const rule = mask('Ship ORD-991 to Acme Corp', {
  on: [],
  rules: [
    { pattern: 'ORD-(\\d+)', replacement: 'order #$1', regex: true },
    { pattern: 'Acme Corp', replacement: 'the client' },
  ],
});
---

<section class="section" id="customize" aria-labelledby="customize-title">
  <div class="wrap">
    <p class="file reveal"><b>§ 03</b><span>Controls</span><span>All local, all yours</span></p>
    <h2 id="customize-title" class="section-title reveal">Your rules. Your labels. <em>Your call.</em></h2>

    <div class="bento">
      <article class="tile wide reveal">
        <h3>Three ways to mask</h3>
        <p>Labels name what was hidden, dots keep the layout, partial keeps just enough to recognise it. Set one style globally or per detector.</p>
        <ul class="styles">
          {styles.map((s) => (
            <li><span class="k">{s.style}</span><code>{s.out}</code></li>
          ))}
        </ul>
      </article>

      <article class="tile reveal">
        <h3>Custom rules</h3>
        <p>Exact text or regex, case-sensitive if you want, with <code>$1</code> capture groups.</p>
        <div class="demo">
          <code class="before">Ship ORD-991 to Acme Corp</code>
          <code class="after">{rule}</code>
        </div>
      </article>

      <article class="tile reveal">
        <h3>Your own labels</h3>
        <p>Rename any detector's label, so <code>[email]</code> can read however you like.</p>
        <div class="demo"><code class="after">{custom}</code></div>
      </article>

      <article class="tile reveal">
        <h3>Skip sites</h3>
        <p>Turn MailHush off for a site and its subdomains in one click from the popup.</p>
        <div class="site"><span class="sdot"></span><code>mail.google.com</code><span class="skip">skipped</span></div>
      </article>

      <article class="tile reveal">
        <h3>One shortcut</h3>
        <p>Pause or resume masking everywhere without opening anything.</p>
        <div class="keys"><kbd>Alt</kbd><kbd>Shift</kbd><kbd>M</kbd></div>
      </article>

      <article class="tile reveal">
        <h3>Forms keep working</h3>
        <p>Fields show the real value while you type in them, and forms submit and validate what you typed, never the mask.</p>
      </article>

      <article class="tile reveal">
        <h3>Back it up</h3>
        <p>Export every setting and rule as JSON, and import it on another browser.</p>
      </article>
    </div>
  </div>
</section>

<style>
  .bento { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 48px; border-top: 1.5px solid var(--ink); border-left: 1.5px solid var(--ink); }
  @media (max-width: 960px) { .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .bento { grid-template-columns: 1fr; } }
  .tile { display: flex; flex-direction: column; gap: 10px; padding: 26px 26px 28px; background: var(--sheet); border-right: 1.5px solid var(--ink); border-bottom: 1.5px solid var(--ink); transition: background 0.2s; }
  .tile:hover { background: var(--paper-2); }
  .tile.wide { grid-column: span 2; }
  @media (max-width: 620px) { .tile.wide { grid-column: auto; } }
  .tile h3 { font-size: 27px; line-height: 1.1; }
  .tile p { color: var(--ink-2); font-size: 17px; }
  .tile code { color: var(--ink); }
  .styles { list-style: none; padding: 0; margin: 10px 0 0; display: grid; border-top: 1px solid var(--rule-2); }
  .styles li { display: grid; grid-template-columns: 86px 1fr; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--rule-2); }
  .k { font: 600 11px/1 var(--mono); text-transform: uppercase; letter-spacing: 0.14em; color: var(--stamp); }
  .styles code { font-size: 16px; overflow-wrap: anywhere; }
  .demo { margin-top: auto; display: grid; gap: 6px; padding: 12px 14px; border: 1px dashed var(--rule-2); font-size: 14px; }
  .demo .before { color: var(--ink-3); text-decoration: line-through; text-decoration-color: var(--stamp); }
  .demo .after { color: var(--ink); overflow-wrap: anywhere; }
  .site { margin-top: auto; display: flex; align-items: center; gap: 10px; padding: 12px 14px; border: 1px dashed var(--rule-2); font-size: 14px; }
  .sdot { width: 8px; height: 8px; background: var(--stamp); }
  .skip { margin-left: auto; font: 600 11px/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--stamp); }
  .keys { margin-top: auto; display: flex; gap: 6px; }
  kbd { padding: 8px 12px; border: 1.5px solid var(--ink); background: var(--paper); box-shadow: 0 3px 0 var(--ink); color: var(--ink); font-size: 14px; }
</style>
