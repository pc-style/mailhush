---
import { mask } from '../lib/mask';

const email = 'jane.doe@acme-corp.com';
const styles = (['label', 'dots', 'partial'] as const).map((style) => ({ style, out: mask(email, { style }) }));
const custom = mask(`${email} · 4111 1111 1111 1111`, { labels: { email: '<redacted>' } });
const rule = mask('Ship ORD-991 to Acme Corp', {
  on: [],
  rules: [
    { pattern: 'ORD-(\\d+)', replacement: 'order #$1', regex: true },
    { pattern: 'Acme Corp', replacement: 'the client' },
  ],
});
---

<section class="section" id="customize" aria-labelledby="customize-title">
  <div class="wrap">
    <h2 id="customize-title" class="section-title reveal">Set it up your way</h2>

    <div class="bento">
      <article class="tile wide reveal">
        <h3>Three ways to mask</h3>
        <p>Labels name what was hidden, dots keep the layout, partial keeps just enough to recognise it. Set one style globally or per detector.</p>
        <ul class="styles">
          {styles.map((s) => (
            <li><span class="k">{s.style}</span><code>{s.out}</code></li>
          ))}
        </ul>
      </article>

      <article class="tile reveal">
        <h3>Custom rules</h3>
        <p>Exact text or regex, case-sensitive if you want, with <code>$1</code> capture groups.</p>
        <div class="demo">
          <code class="before">Ship ORD-991 to Acme Corp</code>
          <code class="after">{rule}</code>
        </div>
      </article>

      <article class="tile reveal">
        <h3>Your own labels</h3>
        <p>Rename any detector's label, so <code>[email]</code> can read however you like.</p>
        <div class="demo"><code class="after">{custom}</code></div>
      </article>

      <article class="tile reveal">
        <h3>Skip sites</h3>
        <p>Turn MailHush off for a site and its subdomains in one click from the popup.</p>
        <div class="site"><span class="sdot"></span><code>mail.google.com</code><span class="skip">skipped</span></div>
      </article>

      <article class="tile reveal">
        <h3>One shortcut</h3>
        <p>Pause or resume masking everywhere without opening anything.</p>
        <div class="keys"><kbd>Alt</kbd><kbd>Shift</kbd><kbd>M</kbd></div>
      </article>

      <article class="tile reveal">
        <h3>Forms keep working</h3>
        <p>Fields show the real value while you type in them, and forms submit and validate what you typed, never the mask.</p>
      </article>

      <article class="tile reveal">
        <h3>Back it up</h3>
        <p>Export every setting and rule as JSON, and import it on another browser.</p>
      </article>
    </div>
  </div>
</section>

<style>
  .bento { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 56px; border-top: 1.5px solid var(--text); border-left: 1px solid var(--line-2); }
  @media (max-width: 960px) { .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .bento { grid-template-columns: 1fr; } }
  .tile { display: flex; flex-direction: column; gap: 12px; padding: 30px 28px 32px; border-right: 1px solid var(--line-2); border-bottom: 1px solid var(--line-2); transition: background 0.12s; }
  .tile:hover { background: var(--bg-2); }
  .tile.wide { grid-column: span 2; }
  @media (max-width: 620px) { .tile.wide { grid-column: auto; } }
  .tile h3 { font-size: 28px; line-height: 1; letter-spacing: -0.045em; }
  .tile p { color: var(--text-2); font-size: 16px; }
  .tile code { color: var(--text); }
  .styles { list-style: none; padding: 0; margin: 10px 0 0; display: grid; }
  .styles li { display: grid; grid-template-columns: 96px 1fr; align-items: baseline; padding: 14px 0; border-top: 1px solid var(--line-2); }
  .k { font: 700 15px/1 var(--body); text-transform: capitalize; color: var(--text-3); }
  .styles code { color: var(--mint); font-size: clamp(18px, 2vw, 24px); font-weight: 800; font-family: var(--display); letter-spacing: -0.03em; overflow-wrap: anywhere; }
  .demo { margin-top: auto; display: grid; gap: 6px; padding-top: 16px; border-top: 1px solid var(--line-2); font-size: 16px; }
  .demo .before { color: var(--red); text-decoration: line-through; text-decoration-thickness: 2px; }
  .demo .after { color: var(--mint); overflow-wrap: anywhere; }
  .site { margin-top: auto; display: flex; align-items: center; gap: 10px; padding-top: 16px; border-top: 1px solid var(--line-2); font-size: 16px; }
  .sdot { width: 8px; height: 8px; border-radius: 50%; background: var(--amber); }
  .skip { margin-left: auto; color: var(--amber); font-weight: 700; font-size: 14px; }
  .keys { margin-top: auto; display: flex; gap: 6px; }
  kbd { padding: 9px 13px; border-radius: 4px; background: var(--text); color: var(--bg); box-shadow: inset 0 -3px 0 rgba(0, 0, 0, 0.25); font-size: 16px; font-weight: 800; }
</style>
