---
const covers = [
  'Text on the page, including open shadow DOM',
  'Same-origin, srcdoc, and about:blank frames, and cross-origin frames on regular sites',
  'Text, search, email, URL, and phone fields, and textareas, until you focus them',
  'Tooltips, alt text, placeholders, aria-labels, and the tab title',
  'Content added later by the page or set from scripts',
];
const misses = [
  'A field or editor while it is focused. It shows the real value so you can work.',
  'Number, password, date, and other non-text inputs',
  'Closed shadow DOM, data: frames, and pages browsers lock to extensions (browser settings, extension stores)',
  'Images, video, canvas, and PDFs',
  'The address bar, bookmarks, and other browser UI',
  'The page source, network traffic, and the data the site stores',
];
---

<section class="section" id="limits" aria-labelledby="limits-title">
  <div class="wrap">
    <p class="file reveal"><b>§ 04</b><span>Limits</span><span>Read before sharing</span></p>
    <h2 id="limits-title" class="section-title reveal">Know exactly what it <em>covers.</em></h2>
    <p class="section-lede reveal">MailHush changes what is drawn on screen, not what the site knows. Check anything sensitive before you share it.</p>

    <div class="cols">
      <div class="col yes reveal">
        <h3>Masks</h3>
        <ul>{covers.map((c) => <li>{c}</li>)}</ul>
      </div>
      <div class="col no reveal">
        <h3>Doesn't mask</h3>
        <ul>{misses.map((c) => <li>{c}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<style>
  .cols { display: grid; grid-template-columns: 1fr 1fr; margin-top: 48px; border: 1.5px solid var(--ink); }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr; } }
  .col { padding: 26px 28px 20px; background: var(--sheet); }
  .no { border-left: 1.5px solid var(--ink); background: var(--paper-2); }
  @media (max-width: 760px) { .no { border-left: 0; border-top: 1.5px solid var(--ink); } }
  .col h3 { font: 600 12px/1 var(--mono); letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 16px; display: inline-block; padding: 6px 9px; border: 2px solid currentColor; transform: rotate(-2deg); }
  .yes h3 { color: var(--ok); }
  .no h3 { color: var(--stamp); }
  ul { list-style: none; margin: 0; padding: 0; }
  li { padding: 12px 0 12px 28px; border-top: 1px solid var(--rule); color: var(--ink-2); font-size: 17px; position: relative; }
  li::before { position: absolute; left: 0; top: 12px; font: 600 15px/1.6 var(--mono); }
  .yes li::before { content: '✓'; color: var(--ok); }
  .no li::before { content: '✗'; color: var(--stamp); }
</style>
