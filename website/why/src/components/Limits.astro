---
const covers = [
  'Text on the page, including open shadow DOM',
  'Same-origin, srcdoc, and about:blank frames, and cross-origin frames on regular sites',
  'Text, search, email, URL, and phone fields, and textareas, until you focus them',
  'Tooltips, alt text, placeholders, aria-labels, and the tab title',
  'Content added later by the page or set from scripts',
];
const misses = [
  'A field or editor while it is focused. It shows the real value so you can work.',
  'Number, password, date, and other non-text inputs',
  'Closed shadow DOM, data: frames, and pages browsers lock to extensions (browser settings, extension stores)',
  'Images, video, canvas, and PDFs',
  'The address bar, bookmarks, and other browser UI',
  'The page source, network traffic, and the data the site stores',
];
---

<section class="section" id="limits" aria-labelledby="limits-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="limits-title" class="section-title reveal">What it won’t hide</h2>
      <p class="section-lede reveal">MailHush changes what is drawn on screen, not what the site knows. Check anything sensitive before you share it.</p>
    </header>

    <div class="cols">
      <div class="col yes reveal">
        <h3>Masks</h3>
        <ul>{covers.map((c) => <li>{c}</li>)}</ul>
      </div>
      <div class="col no reveal">
        <h3>Doesn't mask</h3>
        <ul>{misses.map((c) => <li>{c}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<style>
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 0 56px; margin-top: 56px; }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr; gap: 48px; } }
  .col { border-top: 1.5px solid var(--text); padding-top: 22px; }
  .col h3 { font-size: 34px; letter-spacing: -0.045em; margin-bottom: 12px; }
  .yes h3 { color: var(--mint); }
  .no h3 { color: var(--red); }
  ul { list-style: none; margin: 0; padding: 0; }
  li { padding: 13px 0 13px 30px; border-top: 1px solid var(--line-2); color: var(--text-2); font-size: 16px; position: relative; }
  li::before { position: absolute; left: 0; top: 12px; font: 800 17px/1.6 var(--body); }
  .yes li::before { content: '✓'; color: var(--mint); }
  .no li::before { content: '×'; color: var(--red); }
</style>
