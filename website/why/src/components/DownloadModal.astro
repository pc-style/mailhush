---
// src/components/DownloadModal.astro
import GitHubIcon from '../assets/GitHub-dark.svg?raw';
import ZenIcon from '../assets/Zen Browser-dark.svg?raw';
import ChromeIcon from '../assets/Chrome.svg?raw';
---

<dialog id="download-modal" class="modal">
  <div class="modal-content">
    <button class="close-btn" aria-label="Close modal">&times;</button>
    <h2 class="modal-title">Get MailHush</h2>
    <p class="modal-desc">Free, and it runs entirely in your browser.</p>
    
    <div class="modal-options">
      <a href="https://github.com/pc-style/mailhush/releases/latest" class="modal-btn github" target="_blank" rel="noopener">
        <div class="icon-wrapper" set:html={GitHubIcon} />
        <div class="btn-text">
          <span class="btn-name">Chromium browsers</span>
          <span class="btn-status available">GitHub Releases</span>
        </div>
      </a>
      
      <a href="https://addons.mozilla.org/en-US/firefox/addon/mailhush/" class="modal-btn firefox" target="_blank" rel="noopener">
        <div class="icon-wrapper" set:html={ZenIcon} />
        <div class="btn-text">
          <span class="btn-name">Firefox &amp; Zen</span>
          <span class="btn-status available">Firefox Add-ons</span>
        </div>
      </a>
      
      <button class="modal-btn chrome disabled" disabled title="Coming soon to Chrome Web Store">
        <div class="icon-wrapper" set:html={ChromeIcon} />
        <div class="btn-text">
          <span class="btn-name">Chrome</span>
          <span class="btn-status coming-soon">Coming Soon</span>
        </div>
      </button>
    </div>
  </div>
</dialog>

<style>
  .modal { margin: auto; background: transparent; border: none; padding: 0; color: var(--ink); }
  .modal::backdrop { background: rgba(22, 20, 15, 0.55); }
  .modal-content { position: relative; width: min(92vw, 440px); padding: 30px; background: var(--sheet); border: 1.5px solid var(--ink); box-shadow: 10px 10px 0 var(--ink); font-family: var(--body); }
  .close-btn { position: absolute; top: 12px; right: 12px; width: 34px; height: 34px; border: 1.5px solid var(--ink); background: var(--paper); color: var(--ink); font-size: 20px; line-height: 1; cursor: pointer; }
  .close-btn:hover { background: var(--ink); color: var(--paper); }
  .modal-title { font: 600 34px/1 var(--display); letter-spacing: -0.02em; margin: 0 0 8px; }
  .modal-desc { color: var(--ink-2); font-size: 17px; font-style: italic; margin: 0 0 22px; }
  .modal-options { display: grid; gap: 10px; }
  .modal-btn { display: flex; align-items: center; gap: 16px; width: 100%; padding: 15px 16px; border: 1.5px solid var(--ink); background: var(--paper); color: var(--ink); text-align: left; text-decoration: none; cursor: pointer; font: inherit; transition: transform 0.15s var(--ease), box-shadow 0.15s var(--ease); }
  .modal-btn:hover:not(.disabled) { transform: translate(-2px, -2px); box-shadow: 4px 4px 0 var(--stamp); }
  .modal-btn.disabled { opacity: 0.45; cursor: not-allowed; filter: grayscale(1); }
  .icon-wrapper { width: 30px; height: 30px; flex-shrink: 0; }
  .icon-wrapper :global(svg) { width: 100%; height: 100%; }
  .btn-text { display: flex; flex-direction: column; }
  .btn-name { font: 600 19px/1.2 var(--display); }
  .btn-status { font: 12px/1.4 var(--mono); color: var(--ink-3); }
  .available { color: var(--stamp); }
</style>

<script>
  // Script runs once when the component is loaded
  const modal = document.getElementById('download-modal') as HTMLDialogElement;
  const openBtns = document.querySelectorAll('.open-download-modal');
  const closeBtn = document.querySelector('.close-btn');

  openBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      modal?.showModal();
    });
  });

  closeBtn?.addEventListener('click', () => {
    modal?.close();
  });
  
  // Close when clicking outside the modal content
  modal?.addEventListener('click', (e) => {
    const dialogDimensions = modal.getBoundingClientRect();
    if (
      e.clientX < dialogDimensions.left ||
      e.clientX > dialogDimensions.right ||
      e.clientY < dialogDimensions.top ||
      e.clientY > dialogDimensions.bottom
    ) {
      modal.close();
    }
  });
</script>
