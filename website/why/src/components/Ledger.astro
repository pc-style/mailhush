---
import { detectors, mask } from '../lib/mask';

const rows = detectors.map((d) => ({
  ...d,
  label: mask(d.example, { on: [d.id] }),
  partial: mask(d.example, { on: [d.id], style: 'partial' }),
}));
const onCount = rows.filter((r) => r.defaultEnabled).length;
---

<section class="section" id="hides" aria-labelledby="hides-title">
  <div class="wrap">
    <p class="file reveal"><b>§ 02</b><span>Detectors</span><span>11 + your rules</span></p>
    <h2 id="hides-title" class="section-title reveal">Eleven detectors. <em>Checksums,</em> not guesses.</h2>
    <p class="section-lede reveal">
      Card numbers must pass Luhn, IBANs mod-97, and PESEL its checksum and a real birth date, so order IDs and
      version numbers stay readable. {onCount} detectors are on out of the box; switch on the rest in settings.
    </p>

    <div class="ledger reveal" role="table" aria-label="Detectors and what they show">
      <div class="lrow head" role="row">
        <span role="columnheader">Detector</span>
        <span role="columnheader">On the page</span>
        <span role="columnheader">Label</span>
        <span role="columnheader">Partial</span>
      </div>
      {rows.map((r) => (
        <div class="lrow" role="row">
          <span class="name" role="cell">
            <strong>{r.name}</strong>
            {r.defaultEnabled && <em>on by default</em>}
            <small>{r.description}</small>
          </span>
          <span class="mono rawval" role="cell">{r.example}</span>
          <span class="mono" role="cell"><span class="pill">{r.label}</span></span>
          <span class="mono partial" role="cell">{r.partial}</span>
        </div>
      ))}
      <div class="lrow own" role="row">
        <span class="name" role="cell">
          <strong>Your own rules</strong>
          <small>Names, project codes, order numbers. Exact text or a regex, with capture groups.</small>
        </span>
        <span class="mono rawval" role="cell">ORD-2291</span>
        <span class="mono" role="cell"><span class="pill">order #2291</span></span>
        <span class="mono partial" role="cell">ORD-(\d+) → order #$1</span>
      </div>
    </div>
  </div>
</section>

<style>
  .ledger { margin-top: 48px; border-top: 1.5px solid var(--ink); border-bottom: 1.5px solid var(--ink); }
  .lrow { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1.2fr) minmax(0, 0.7fr) minmax(0, 1fr); gap: 24px; align-items: center; padding: 18px 4px; border-bottom: 1px solid var(--rule); }
  .lrow:last-child { border-bottom: 0; }
  .lrow:not(.head):hover { background: var(--paper-2); }
  .head { font: 600 11px/1 var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); padding: 14px 4px; border-bottom: 1px solid var(--ink); }
  .name strong { font: 600 21px/1.2 var(--display); letter-spacing: -0.01em; }
  .name em { font: 600 10px/1 var(--mono); font-style: normal; letter-spacing: 0.12em; text-transform: uppercase; color: var(--stamp); border: 1px solid var(--stamp); padding: 2px 4px; margin-left: 10px; vertical-align: 3px; white-space: nowrap; display: inline-block; }
  .name small { display: block; color: var(--ink-3); font-size: 15px; font-style: italic; line-height: 1.45; margin-top: 3px; }
  .mono { font: 13px/1.5 var(--mono); overflow-wrap: anywhere; }
  .rawval { color: var(--stamp); }
  .partial { color: var(--ink-2); }
  .lrow :global(.pill) { background: var(--bar); color: var(--paper); padding: 2px 6px; white-space: nowrap; }
  .own { background: repeating-linear-gradient(-45deg, transparent 0 8px, var(--rule) 8px 9px); }
  .own .partial { color: var(--ink-3); }
  @media (max-width: 860px) { .head { display: none; } .lrow { grid-template-columns: 1fr 1fr; gap: 10px 16px; } .name { grid-column: 1 / -1; } .partial { display: none; } }
</style>
