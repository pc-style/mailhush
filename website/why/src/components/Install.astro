---
import GitHubIcon from '../assets/GitHub-dark.svg?raw';
import ZenIcon from '../assets/Zen Browser-dark.svg?raw';
import ChromeIcon from '../assets/Chrome.svg?raw';
---

<section class="section install" id="install" aria-labelledby="install-title">
  <div class="wrap">
    <div class="panel reveal">
      <div class="copy">
        <p class="file"><b>§ 05</b><span>Install</span><span>Free</span></p>
        <h2 id="install-title" class="section-title">Black it out before you <em>hit share.</em></h2>
        <p class="section-lede">Free. Runs entirely in your browser. The source is public on GitHub.</p>
      </div>
      <div class="options">
        <a class="opt" href="https://addons.mozilla.org/en-US/firefox/addon/mailhush/" target="_blank" rel="noopener">
          <span class="ico" set:html={ZenIcon} />
          <span class="t"><strong>Firefox &amp; Zen</strong><small>Firefox Add-ons</small></span>
          <span class="go" aria-hidden="true">↗</span>
        </a>
        <a class="opt" href="https://github.com/pc-style/mailhush/releases/latest" target="_blank" rel="noopener">
          <span class="ico" set:html={GitHubIcon} />
          <span class="t"><strong>Chromium browsers</strong><small>Zip from GitHub Releases, load unpacked</small></span>
          <span class="go" aria-hidden="true">↗</span>
        </a>
        <div class="opt soon" aria-disabled="true">
          <span class="ico" set:html={ChromeIcon} />
          <span class="t"><strong>Chrome Web Store</strong><small>Coming soon</small></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .panel { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 48px; align-items: center; padding: 48px; background: var(--ink); color: var(--paper); box-shadow: 10px 10px 0 var(--stamp); }
  @media (max-width: 900px) { .panel { grid-template-columns: 1fr; padding: 30px 22px; gap: 30px; } }
  .panel :global(.file) { color: rgba(242, 237, 227, 0.6); border-bottom-color: rgba(242, 237, 227, 0.4); }
  .panel :global(.section-lede) { color: rgba(242, 237, 227, 0.75); }
  .options { display: grid; gap: 10px; }
  .opt { display: flex; align-items: center; gap: 16px; padding: 16px 18px; border: 1.5px solid rgba(242, 237, 227, 0.35); text-decoration: none; transition: background 0.2s, color 0.2s, border-color 0.2s; }
  a.opt:hover { background: var(--paper); color: var(--ink); border-color: var(--paper); }
  .ico { width: 30px; height: 30px; flex-shrink: 0; }
  .ico :global(svg) { width: 100%; height: 100%; }
  .t { display: flex; flex-direction: column; }
  .t strong { font: 600 19px/1.2 var(--display); }
  .t small { font: 12px/1.4 var(--mono); opacity: 0.7; }
  .go { margin-left: auto; font: 600 18px var(--mono); }
  .soon { opacity: 0.45; filter: grayscale(1); }
</style>
