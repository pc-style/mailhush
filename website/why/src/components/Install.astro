---
import GitHubIcon from '../assets/GitHub-dark.svg?raw';
import ZenIcon from '../assets/Zen Browser-dark.svg?raw';
import ChromeIcon from '../assets/Chrome.svg?raw';
---

<section class="section install" id="install" aria-labelledby="install-title">
  <div class="wrap">
    <div class="panel reveal">
      <div class="copy">
        <h2 id="install-title" class="section-title">Install MailHush</h2>
        <p class="section-lede">Free. Runs entirely in your browser. The source is public on GitHub.</p>
      </div>
      <div class="options">
        <a class="opt" href="https://addons.mozilla.org/en-US/firefox/addon/mailhush/" target="_blank" rel="noopener">
          <span class="ico" set:html={ZenIcon} />
          <span class="t"><strong>Firefox &amp; Zen</strong><small>Firefox Add-ons</small></span>
          <span class="go" aria-hidden="true">↗</span>
        </a>
        <a class="opt" href="https://github.com/pc-style/mailhush/releases/latest" target="_blank" rel="noopener">
          <span class="ico" set:html={GitHubIcon} />
          <span class="t"><strong>Chromium browsers</strong><small>Zip from GitHub Releases, load unpacked</small></span>
          <span class="go" aria-hidden="true">↗</span>
        </a>
        <div class="opt soon" aria-disabled="true">
          <span class="ico" set:html={ChromeIcon} />
          <span class="t"><strong>Chrome Web Store</strong><small>Coming soon</small></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    padding: 56px;
    border-radius: 24px;
    background: var(--card);
    box-shadow: 0 0 0 1px var(--line-2);
  }
  @media (max-width: 900px) { .panel { grid-template-columns: 1fr; padding: 32px 22px; gap: 32px; } }
  .options { display: grid; gap: 10px; }
  .opt { display: flex; align-items: center; gap: 16px; padding: 16px 18px; border-radius: 14px; background: var(--bg-2); box-shadow: 0 0 0 1px var(--line); text-decoration: none; transition: transform 0.25s var(--ease), box-shadow 0.25s; }
  a.opt:hover { box-shadow: 0 0 0 1px var(--mint); }
  .ico { width: 30px; height: 30px; flex-shrink: 0; }
  .ico :global(svg) { width: 100%; height: 100%; }
  .t { display: flex; flex-direction: column; }
  .t strong { font-weight: 600; }
  .t small { color: var(--text-3); font-size: 13px; }
  .go { margin-left: auto; color: var(--mint); font-size: 18px; }
  .soon { opacity: 0.5; filter: grayscale(1); }
</style>
