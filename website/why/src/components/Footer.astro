---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
---

<footer class="footer">
  <div class="wrap inner">
    <a class="brand" href="https://github.com/pc-style/mailhush">
      <Image src={logo} alt="" width={26} height={26} />
      MailHush
    </a>
    <p>The extension makes no network requests. This website uses Vercel Analytics.</p>
    <nav aria-label="Footer">
      <a href="https://github.com/pc-style/mailhush">Source</a>
      <a href="https://github.com/pc-style/mailhush#trust-and-privacy-boundary">Privacy boundary</a>
      <a href="https://github.com/pc-style/mailhush/releases">Releases</a>
    </nav>
  </div>
</footer>

<style>
  .footer { margin-top: 128px; border-top: 1.5px solid var(--ink); padding: 28px 0 44px; font: 13px/1.5 var(--mono); color: var(--ink-3); }
  .inner { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); font: 600 19px/1 var(--display); }
  .brand img { width: 26px; height: 26px; border-radius: 6px; }
  nav { display: flex; gap: 18px; margin-left: auto; }
  nav a { text-decoration: underline 1px var(--rule-2); text-underline-offset: 4px; }
  nav a:hover { color: var(--stamp); text-decoration-color: var(--stamp); }
  @media (max-width: 700px) { nav { margin-left: 0; } }
</style>
