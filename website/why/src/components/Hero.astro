---
// The memo's sensitive spans are redacted on load by the script below.
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="meta reveal">
      <span>Browser extension</span><span>Chromium · Firefox · Zen</span><span>Free · Runs locally</span>
    </div>

    <h1 id="hero-title" class="reveal">
      Share your screen.<br />
      Keep the <span class="hbar" aria-hidden="true"><span>details</span></span><span class="visually-hidden">details</span> to&nbsp;yourself.
    </h1>

    <div class="grid">
      <div class="memo-col reveal">
        <article class="memo" aria-label="Example: a memo before and after MailHush">
          <header class="memo-head">
            <span>MEMO · INTERNAL</span>
            <span class="stamp">Masked</span>
          </header>
          <dl>
            <dt>To</dt><dd><span class="r">marcus.lee@acme-corp.com</span></dd>
            <dt>Re</dt><dd>Q3 payout to <span class="r">DE89 3704 0044 0532 0130 00</span></dd>
          </dl>
          <p>
            Card on file is <span class="r">4111 1111 1111 1111</span>. Call me on <span class="r">+48 601 234 567</span> if
            the charge fails, and rotate <span class="r">sk_live_••••••••••••</span> before the demo.
          </p>
        </article>
        <p class="lede">
          MailHush blacks out emails, card numbers, IBANs, API keys, phone numbers and your own words
          in the page as it renders. Streams, screenshots and client calls show only what you meant to show.
        </p>
        <div class="actions">
          <button class="btn btn-primary open-download-modal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M4 21h16" /></svg>
            Install MailHush
          </button>
          <a class="btn btn-ghost" href="#try">Try it on this page</a>
        </div>
      </div>

      <figure class="exhibit reveal">
        <figcaption class="tag"><b>Exhibit A</b> · recorded from MailHush 2.0</figcaption>
        <div class="frame">
          <video autoplay muted loop playsinline preload="metadata" poster="/assets/demo-poster.jpg" width="1200" height="750">
            <source src="/assets/demo.webm" type="video/webm" />
            <source src="/assets/demo.mp4" type="video/mp4" />
          </video>
        </div>
        <p class="note">Label, partial and dots styles on a real account page, then a focused field showing what you type.</p>
      </figure>
    </div>

    <ul class="facts reveal">
      <li><b>11</b> detectors, checksum-verified</li>
      <li><b>3</b> mask styles, per detector</li>
      <li><b>0</b> network requests</li>
      <li><b>∞</b> custom rules</li>
    </ul>
  </div>
</section>

<style>
  .hero { padding: 56px 0 0; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 28px; font: 500 12px/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); padding-bottom: 18px; border-bottom: 1px solid var(--ink); }
  .meta span:last-child { margin-left: auto; }
  @media (max-width: 640px) { .meta span:last-child { margin-left: 0; } }

  h1 { font-size: clamp(48px, 8.4vw, 116px); line-height: 0.96; letter-spacing: -0.035em; margin: 36px 0 0; font-weight: 500; }
  .hbar { position: relative; display: inline-block; font-style: italic; }
  .hbar::after { content: ''; position: absolute; inset: -0.02em -0.06em 0.02em; background: var(--bar); transform-origin: left; transform: scaleX(0); animation: strike 0.7s 1.1s var(--ease) forwards; }
  @keyframes strike { to { transform: scaleX(1); } }

  .grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 56px; margin-top: 56px; align-items: start; }
  @media (max-width: 960px) { .grid { grid-template-columns: 1fr; gap: 48px; } }

  .memo { background: var(--sheet); border: 1px solid var(--rule-2); padding: 22px 24px 24px; font: 14px/1.8 var(--mono); color: var(--ink-2); box-shadow: 0 1px 0 var(--rule), 8px 10px 0 -1px var(--paper-2), 8px 10px 0 0 var(--rule-2); transform: rotate(-0.8deg); }
  .memo-head { display: flex; justify-content: space-between; align-items: center; font-size: 11px; letter-spacing: 0.16em; color: var(--ink-3); border-bottom: 1px dashed var(--rule-2); padding-bottom: 10px; margin-bottom: 12px; }
  .stamp { color: var(--stamp); border: 2px solid var(--stamp); padding: 4px 8px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; transform: rotate(6deg); opacity: 0; animation: stamp 0.35s 2.6s var(--ease) forwards; }
  @keyframes stamp { from { opacity: 0; transform: rotate(6deg) scale(1.8); } to { opacity: 0.9; transform: rotate(6deg) scale(1); } }
  dl { display: grid; grid-template-columns: 34px 1fr; gap: 2px 10px; margin: 0 0 10px; }
  dt { color: var(--ink-3); }
  dd { margin: 0; }
  .r { position: relative; color: var(--stamp); white-space: nowrap; }
  :global(.js) .r::after { transform: scaleX(0); }
  .r::after { content: ''; position: absolute; inset: 0.1em 0.1em 0.04em; background: var(--bar); transform-origin: left; transition: transform 0.45s var(--ease); }
  .memo.done .r { color: transparent; }
  .memo.done .r::after, .r.on::after { transform: scaleX(1); }

  .lede { font-size: 21px; line-height: 1.55; color: var(--ink-2); margin-top: 40px; max-width: 46ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }

  .exhibit { margin: 0; }
  .tag { font: 500 12px/1 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 10px; }
  .tag b { color: var(--stamp); font-weight: 600; }
  .frame { border: 1.5px solid var(--ink); background: var(--sheet); padding: 8px; box-shadow: 10px 10px 0 var(--ink); }
  video { width: 100%; height: auto; aspect-ratio: 1200 / 750; background: #f6f7f9; }
  .note { font-size: 15px; font-style: italic; color: var(--ink-3); margin-top: 18px; }

  .facts { list-style: none; margin: 72px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .facts li { padding: 18px 20px 20px; border-left: 1px solid var(--rule-2); font: 13px/1.4 var(--mono); color: var(--ink-2); }
  .facts li:first-child { border-left: 0; padding-left: 0; }
  .facts b { display: block; font: 500 44px/1 var(--display); color: var(--ink); margin-bottom: 6px; }
  @media (max-width: 760px) { .facts { grid-template-columns: 1fr 1fr; } .facts li:nth-child(3) { border-left: 0; padding-left: 0; } .facts li:nth-child(n+3) { border-top: 1px solid var(--rule-2); } }
</style>

<script>
  const memo = document.querySelector<HTMLElement>('.memo')!;
  const bars = [...memo.querySelectorAll<HTMLElement>('.r')];
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    memo.classList.add('done');
    document.querySelector<HTMLVideoElement>('.frame video')?.pause();
  } else {
    // Redact one value at a time, as MailHush would while the page renders.
    bars.forEach((bar, i) => setTimeout(() => bar.classList.add('on'), 1500 + i * 220));
    setTimeout(() => memo.classList.add('done'), 1500 + bars.length * 220 + 300);
  }
</script>
