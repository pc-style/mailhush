---
// Words the headline cycles through, each with what MailHush writes in its place.
const words = [
  { raw: 'email', masked: '[email]' },
  { raw: 'card', masked: '[card]' },
  { raw: 'API key', masked: '[secret]' },
  { raw: 'IBAN', masked: '[IBAN]' },
  { raw: 'phone', masked: '[phone]' },
];
const line1 = ['Share', 'your', 'screen.'];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap">
    <p class="eyebrow reveal">A browser extension for Chromium, Firefox and Zen</p>
    <h1 id="hero-title">
      {line1.map((w, i) => <><span class="w" style={`--i:${i}`}>{w}</span>{' '}</>)}<br />
      <span class="w" style="--i:3">Not</span>{' '}<span class="w" style="--i:4">your</span>{' '}<span class="w" style="--i:5"><span class="slot" aria-hidden="true" data-words={JSON.stringify(words)}><span class="v">{words[0].raw}</span></span><span class="visually-hidden">data</span>.</span>
    </h1>

    <div class="under">
      <p class="lede reveal">
        MailHush rewrites emails, card numbers, IBANs, API keys, phone numbers and your own words in the page as it
        renders. Streams, screenshots and client demos only show what you meant to show.
      </p>
      <div class="actions reveal">
        <button class="btn btn-primary open-download-modal">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M4 21h16" /></svg>
          Install MailHush
        </button>
        <a class="btn btn-ghost" href="#try">Try it on this page</a>
      </div>
    </div>

    <figure class="screen reveal">
      <video autoplay muted loop playsinline preload="metadata" poster="/assets/demo-poster.jpg" width="1200" height="750">
        <source src="/assets/demo.webm" type="video/webm" />
        <source src="/assets/demo.mp4" type="video/mp4" />
      </video>
      <figcaption>Recorded from MailHush 2.0 on a real page: label, partial and dots styles, then a focused field showing what you type.</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { padding: 88px 0 0; }
  h1 { font-size: clamp(64px, 11.4vw, 176px); line-height: 0.88; letter-spacing: -0.05em; }
  .w { display: inline-block; }
  :global(.js) .w { animation: land 0.34s var(--snap) both; animation-delay: calc(0.1s + var(--i) * 0.08s); }

  /* The extension swaps text in place, so the headline does too: raw word in red, then its label in mint. */
  .slot { display: inline-block; vertical-align: top; white-space: nowrap; transition: width 0.14s var(--snap); }
  .v { display: inline-block; color: var(--red); transform-origin: 30% 65%; }
  .slot.masked .v { color: var(--mint); }
  .v.punch { animation: punch 0.2s var(--snap); }
  .v.squash { animation: squash 0.07s ease-in forwards; }

  .under { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 32px 64px; align-items: end; margin-top: 56px; padding-top: 28px; border-top: 1.5px solid var(--line-2); }
  @media (max-width: 900px) { .under { grid-template-columns: 1fr; } }
  .lede { font-size: 20px; line-height: 1.5; color: var(--text-2); max-width: 54ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }

  .screen { margin: 64px 0 0; border-radius: var(--radius); overflow: hidden; background: var(--card); box-shadow: 0 0 0 1.5px var(--line-2); }
  video { width: 100%; height: auto; aspect-ratio: 1200 / 750; background: #f6f7f9; }
  figcaption { padding: 14px 18px; font-size: 14px; color: var(--text-3); border-top: 1.5px solid var(--line-2); }
</style>

<script>
  const slot = document.querySelector<HTMLElement>('.slot')!;
  const v = slot.querySelector<HTMLElement>('.v')!;
  const words: { raw: string; masked: string }[] = JSON.parse(slot.dataset.words!);
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  // Change the text and close the gap around it in one hit.
  const set = (text: string, masked: boolean) => {
    const from = slot.offsetWidth;
    v.classList.remove('squash', 'punch');
    v.textContent = text;
    slot.classList.toggle('masked', masked);
    slot.style.width = 'auto';
    const to = slot.offsetWidth;
    slot.style.width = `${from}px`;
    void slot.offsetWidth;
    slot.style.width = `${to}px`;
    v.classList.add('punch');
  };

  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    v.textContent = words[0].masked;
    slot.classList.add('masked');
    document.querySelector<HTMLVideoElement>('.screen video')?.pause();
  } else {
    (async () => {
      await wait(1500);
      for (let i = 0; ; i = (i + 1) % words.length) {
        v.classList.add('squash');
        await wait(70);
        set(words[i].masked, true);
        await wait(1430);
        set(words[(i + 1) % words.length].raw, false);
        await wait(1000);
      }
    })();
  }
</script>
